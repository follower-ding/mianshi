FROM node:22-alpine AS build
WORKDIR /app
COPY mianshi-api/package*.json ./
RUN npm ci
COPY mianshi-api/ ./
RUN npm run build \
  && mkdir -p dist/db \
  && cp src/db/schema.sql dist/db/schema.sql

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache wget
COPY mianshi-api/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY mianshi-api/data ./data
EXPOSE 8788
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=40s \
  CMD wget -qO- http://127.0.0.1:8788/api/health || exit 1
CMD ["node", "dist/index.js"]
